# Copie para .env e preencha. O .env é ignorado pelo git — este repositório é
# público, então nenhum segredo pode ser versionado (CLAUDE.md, regra 8).

SUPABASE_PROJECT_ID="<project-ref>"
SUPABASE_URL="https://<project-ref>.supabase.co"

# Chave publishable (anon). Pode ir para o browser — quem protege os dados é o RLS.
# Supabase → Project Settings → API Keys → publishable
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# SEGREDO. Ignora RLS por completo — acesso total de leitura e escrita.
# Supabase → Project Settings → API Keys → service_role
# Só no servidor. Nunca com prefixo VITE_ (o Vite embutiria o valor no bundle).
# Em produção, defina como variável de ambiente da hospedagem, não em arquivo.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Espelhos com prefixo VITE_ para o código do client. Só valores públicos aqui.
VITE_SUPABASE_PROJECT_ID="<project-ref>"
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
